# ── API Keys ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Pathnovo (enhanced fallback — ISA 5.1 extraction API) ────────────────────
PATHNOVO_API_KEY=your_pathnovo_key_here
PATHNOVO_TIMEOUT=60
PATHNOVO_MAX_RETRIES=3

# ── Model Versions ───────────────────────────────────────────────────────────────
# Gemini: 2.5-flash (default, fast) or 2.5-pro (higher accuracy, slower)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# Qwen: upgraded to qwen2.5-vl-72b-instruct (better vision understanding)
QWEN_MODEL=qwen/qwen2.5-vl-72b-instruct
QWEN_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o
GROQ_MODEL=llama-3.3-70b-versatile

# ── Per-Agent Token Budgets ─────────────────────────────────────────────────────
# TextRecognitionAgent: high budget for dense tag/spec extraction
TEXT_AGENT_MAX_TOKENS=16384
# SymbolRecognitionAgent: moderate budget for structured bounding-box output
SYMBOL_AGENT_MAX_TOKENS=8192
# PipelineRecognitionAgent: moderate budget for relation/geometry lists
PIPELINE_AGENT_MAX_TOKENS=8192
# CompilerAgent: highest budget — builds the full engineering graph
COMPILER_MAX_TOKENS=32768
# Default fallback for all other agents
DEFAULT_MAX_TOKENS=8192

# ── Per-Agent Temperature Tuning ────────────────────────────────────────────────
# Deterministic for tag/spec parsing (must be exact)
TEXT_AGENT_TEMPERATURE=0.0
# Slight randomness helps with ambiguous ISA symbols
SYMBOL_AGENT_TEMPERATURE=0.1
# Deterministic for topology/connectivity tracing
PIPELINE_AGENT_TEMPERATURE=0.0

# ── Retry & Exponential Backoff ─────────────────────────────────────────────────
LLM_MAX_RETRIES=5
LLM_BASE_DELAY_SECONDS=2.0
LLM_MAX_DELAY_SECONDS=60.0

# ── Token Budget Warning ────────────────────────────────────────────────────────
# Warns in logs when response reaches 85% of token budget
LLM_TOKEN_BUDGET_WARN_THRESHOLD=0.85

# ── Text Chunking ────────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=250
